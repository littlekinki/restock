{
  "expo": {
    "name": "Restock",
    "slug": "restock-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "restockmobile",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#01311F",
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.restockshop.restockmobile",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Restock uses your location to find nearby distributors and track deliveries.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Restock uses your location to track deliveries in the background.",
        "NSCameraUsageDescription": "Restock uses your camera to photograph shopping lists.",
        "NSPhotoLibraryUsageDescription": "Restock accesses your photos to upload shopping lists."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3B2C"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.restockshop.restockmobile",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Restock to access your photos to upload shopping lists.",
          "cameraPermission": "Allow Restock to use your camera to photograph shopping lists."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3B2C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd66422f-03c9-4dee-9913-c7da8a8998b5"
      }
    }
  }
}